# S3Player deployment settings. Copy to .env (git-ignored) and fill in, or
# let scripts/setup.sh write it for you. Real environment variables with the
# same names override this file.

# Short name used in every AWS resource name (stack S3PlayerStack-<name>,
# buckets s3player-media-<name>-<account>, ...). Lowercase letters, digits, hyphens.
S3PLAYER_ENV_NAME=dev

# AWS profile and region to deploy into (used by the scripts in ../scripts).
# Leave AWS_PROFILE empty to use your default credentials.
AWS_PROFILE=
AWS_REGION=eu-west-1

# Extra CORS origin allowed on the media bucket, for `npm start` in app/.
S3PLAYER_LOCAL_DEV_ORIGIN=http://localhost:4200

# Optional: your own domain for the site (e.g. media.example.com). Needs an
# ACM certificate for it in us-east-1, and a DNS CNAME pointing the domain at
# the CloudFront distribution (stack output SiteUrl's domain) after deploy.
S3PLAYER_CUSTOM_DOMAIN=
S3PLAYER_CERTIFICATE_ARN=

# Optional: TMDb v3 API key (free: https://www.themoviedb.org/settings/api)
# for movie/TV posters, plots and cast. Empty skips those lookups.
S3PLAYER_TMDB_API_KEY=

# Language of the titles and plots fetched from TMDb (e.g. it-IT, en-US, de-DE).
S3PLAYER_TMDB_LANGUAGE=en-US

# Convert uploaded videos browsers can't play (MKV, AC3/DTS audio) to MP4 and
# extract their embedded subtitles. Deploying it needs Docker running.
# Set to false to skip it (then upload MP4 files with AAC audio yourself).
S3PLAYER_TRANSCODE=true
